"""Unicorn harness for ReplayEditor.dll (phase 2).

The real DLL runs against a fake gta-vc.exe memory image. Game functions are
stubs; PlaybackThisFrame is modelled in Python with the game's pointer /
interpolation semantics (0x6230A0 + 0x621230):
  * one call processes the frame at the committed pointer; if the counter is
    non-zero it also reads the following frame (slow motion);
  * reading END of the status-2 slot = FinishPlayback (Mode -> 0)  -> FAIL;
  * the counter wraps by the divisor and commits the pointer when it is 0.
usage: emu_editor.py some.rep
"""
import struct
import sys
import os

from unicorn import Uc, UC_ARCH_X86, UC_MODE_32, UC_HOOK_CODE
from unicorn.x86_const import UC_X86_REG_ESP, UC_X86_REG_EAX, UC_X86_REG_EIP

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from repparse import load  # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))
DLL = os.path.join(HERE, "..", "native", "obj", "ReplayEditor.dll")   # freshly built
SIZES = {1: 0x34, 2: 0x2C, 3: 0x08, 4: 0x2C, 5: 0x58, 6: 4, 7: 8, 8: 4, 9: 8, 10: 0x1C, 11: 0x14, 12: 0x10}

MODE, BUFSTATUS, BUFFERS = 0xA10AF6, 0x94D4E0, 0x869CB8
PB_OFF, PB_BASE, PB_SLOT = 0x9B5F58, 0x9B5F5C, 0x9B5F60
DIVISOR, CNT = 0xA0D95C, 0x7869B4
STUB_BASE = 0x00300000

uc = Uc(UC_ARCH_X86, UC_MODE_32)
uc.mem_map(0x00200000, 0x00200000)          # stack + stubs
uc.mem_map(0x00400000, 0x00700000)          # game image + bss
dll = open(DLL, "rb").read()
pe = struct.unpack_from("<I", dll, 0x3C)[0]
nsec = struct.unpack_from("<H", dll, pe + 6)[0]
opt = pe + 24
base = struct.unpack_from("<I", dll, opt + 28)[0]
size_img = struct.unpack_from("<I", dll, opt + 56)[0]
uc.mem_map(base, (size_img + 0xFFF) & ~0xFFF)
uc.mem_write(base, dll[:0x400])
sec = opt + struct.unpack_from("<H", dll, pe + 20)[0]
for k in range(nsec):
    va, raw_size, raw_ptr = struct.unpack_from("<III", dll, sec + 40 * k + 12)
    uc.mem_write(base + va, dll[raw_ptr:raw_ptr + raw_size])
# export RE_Init
exp_rva = struct.unpack_from("<I", dll, opt + 96)[0]
nfun = struct.unpack_from("<I", dll, 0)[0]
def rd32(a): return struct.unpack("<I", bytes(uc.mem_read(a, 4)))[0]
def wr32(a, v): uc.mem_write(a, struct.pack("<I", v & 0xFFFFFFFF))
def rd8(a): return uc.mem_read(a, 1)[0]
def wr8(a, v): uc.mem_write(a, bytes([v & 0xFF]))
funcs = rd32(base + exp_rva + 28)
RE_INIT = base + rd32(base + funcs)

# --- stubs: every stub is a 'ret' that a code hook intercepts -------------
stubs, names = {}, {}
def stub(name, addr=None):
    if addr is None:
        addr = STUB_BASE + 16 * len(stubs)
    stubs[addr] = name
    names[name] = addr
    uc.mem_write(addr, b"\xC3")
    return addr

for n in ("GetModuleHandleA", "GetProcAddress", "VirtualProtect", "GetAsyncKeyState",
          "CreateFileA", "WriteFile", "FlushFileBuffers"):
    stub(n)
FS = {}            # fake file system: (dir, name) -> bytearray
HANDLES = {}       # handle -> [key, position]
fsstate = {"cwd": "root", "next": 0x100}
wr32(0x6F2464, names["GetModuleHandleA"])
wr32(0x6F2488, names["GetProcAddress"])
for n, a in (("LookAround", 0x61E970), ("Display", 0x620BE0),
             ("PlayFromHD", 0x61F0E0), ("Finish", 0x6210E0), ("GetPad", 0x4AB060),
             ("Cutscene", 0x54E100), ("SetScale", 0x550230), ("F550140", 0x550140),
             ("F5500d0", 0x5500D0), ("SetWrapx", 0x5500F0), ("F550110", 0x550110),
             ("SetPropOn", 0x550020), ("SetColor", 0x550170), ("SetFontStyle", 0x54FFE0),
             ("PrintString", 0x551040), ("DrawRect", 0x577B00),
             ("MatUpdateRW", 0x46C3B6), ("RwMatrixUpdate", 0x6437B0),
             ("RwFrameUpd", 0x644D00), ("RwFrameUpd2", 0x645320),
             ("SetDirDocs", 0x48E020), ("SetDir", 0x48E030), ("OpenWrite", 0x48DF70),
             ("FileWrite", 0x48DF30), ("FileClose", 0x48DEA0)):
    stub(n, a)
for n in ("ReadFile", "CloseHandle", "CopyFileA", "VirtualAlloc"):
    stub(n)
uc.mem_map(0x01000000, 0x00100000)                # VirtualAlloc arena (8 x 100000 fits)
uc.mem_write(0x6DB604, b"replay.rep\0")
uc.mem_write(0x6DB610, b"gtaVC7f\0")
uc.mem_write(0x6DB638, b"\0")
wr32(0x61F0EE, 0x6DB604)                            # PlayReplayFromHD file name operand
stub("timeGetTime")
# PlaybackThisFrame: Python core, then (like 0x6231B7) call ProcessLookAroundCam
core = stub("PlaybackThisFrame")
uc.mem_write(0x6230A0, bytes([0xE8]) + struct.pack("<i", core - (0x6230A0 + 5)))
uc.mem_write(0x6230A5, bytes([0xE9]) + struct.pack("<i", 0x6231B7 - (0x6230A5 + 5)))
uc.mem_write(0x6231B7, bytes([0xE8]) + struct.pack("<i", 0x61E970 - (0x6231B7 + 5)) + bytes([0xC3]))
wr32(0x6F2594, names["timeGetTime"])
# Scene.camera -> fake RwCamera whose +4 is a fake RwFrame
RWCAM, RWFRAME = 0x00390000, 0x00391000
wr32(0x7E4E90, RWCAM); wr32(RWCAM + 4, RWFRAME)

def call_rel(site, target):
    uc.mem_write(site, b"\xE8" + struct.pack("<i", target - (site + 5)))
# CReplay::Update stub: if Mode == 1 -> call PlaybackThisFrame through site 0x624F20
upd = bytes([0x80, 0x3D]) + struct.pack("<I", MODE) + b"\x01"     # cmp byte [MODE],1
upd += b"\x75" + bytes([0x05])                                     # jne +5 -> ret
uc.mem_write(0x624EC0, upd)
uc.mem_write(0x624EC0 + len(upd), b"\xE9" + struct.pack("<i", 0x624F20 - (0x624EC0 + len(upd) + 5)))
uc.mem_write(0x624EC0 + len(upd) + 5, b"\xC3")
call_rel(0x624F20, 0x6230A0); uc.mem_write(0x624F25, b"\xC3")
call_rel(0x4A45C3, 0x624EC0); uc.mem_write(0x4A45C8, b"\xF4")       # hlt
call_rel(0x4A61D6, 0x620BE0); uc.mem_write(0x4A61DB, b"\xF4")
wr8(0x6DB5D8, 1)
pad_area = 0x00380000

keys = set()
state = {"finished": False, "plays": 0, "text": []}
rep_bufs = load(sys.argv[1])

def playback():
    """game semantics of PlaybackThisFrame (divisor/counter/pointer)."""
    state["plays"] += 1
    off, slot = rd32(PB_OFF), rd8(PB_SLOT)
    def read_frame(off, slot):
        b = rep_bufs[slot]
        while True:
            t = b[off] if off < 100000 else 0
            if t == 0:
                if rd8(BUFSTATUS + slot) == 2:
                    return None
                slot = (slot + 1) & 7; off = 0; b = rep_bufs[slot]
                continue
            off += SIZES[t]
            if t == 8:
                return off, slot
    r = read_frame(off, slot)
    if r is None:
        state["finished"] = True; wr8(MODE, 0); return
    cnt, div = rd32(CNT), rd32(DIVISOR)
    if cnt != 0 and read_frame(*r) is None:
        state["finished"] = True; wr8(MODE, 0); return
    cnt = (cnt + 1) % div
    wr32(CNT, cnt)
    if cnt == 0:
        wr32(PB_OFF, r[0]); wr8(PB_SLOT, r[1]); wr32(PB_BASE, BUFFERS + r[1] * 100000)

def play_from_hd():
    for i in range(8):
        wr8(BUFSTATUS + i, 0)
    for i, b in enumerate(rep_bufs):
        uc.mem_write(BUFFERS + i * 100000, b)
        wr8(BUFSTATUS + i, 1)
    wr8(BUFSTATUS + len(rep_bufs) - 1, 2)
    # TriggerPlayback: first slot after the current one with status 1/2
    s = len(rep_bufs) - 1
    s = (s + 1) & 7
    while rd8(BUFSTATUS + s) not in (1, 2):
        s = (s + 1) & 7
    wr8(MODE, 1); wr32(DIVISOR, 1); wr32(CNT, 0)
    wr32(PB_OFF, 0); wr8(PB_SLOT, s); wr32(PB_BASE, BUFFERS + s * 100000)

def read_cstr(a, wide=False):
    out = []
    while True:
        if wide:
            c = struct.unpack("<H", bytes(uc.mem_read(a, 2)))[0]; a += 2
        else:
            c = rd8(a); a += 1
        if not c:
            return "".join(out)
        out.append(chr(c))

def on_code(u, addr, size, _):
    name = stubs.get(addr)
    if not name:
        return
    esp = u.reg_read(UC_X86_REG_ESP)
    arg = lambda i: rd32(esp + 4 + 4 * i)
    ret, pop = 0, 0
    if name == "GetModuleHandleA": ret, pop = 0x7000, 4
    elif name == "GetProcAddress": ret, pop = names.get(read_cstr(arg(1)), 0), 8
    elif name == "VirtualProtect": wr32(arg(3), 0x20); ret, pop = 1, 16
    elif name == "GetAsyncKeyState": ret, pop = (0x8000 if arg(0) in keys else 0), 4
    elif name == "CreateFileA":
        key = ("root", read_cstr(arg(0)))
        if arg(4) == 3 and key not in FS:
            ret = 0xFFFFFFFF
        else:
            if arg(4) == 2 or key not in FS:
                FS[key] = bytearray()
            fsstate["next"] += 1; ret = fsstate["next"]; HANDLES[ret] = [key, 0]
        pop = 28
    elif name == "WriteFile":
        h = HANDLES.get(arg(0))
        data = bytes(uc.mem_read(arg(1), arg(2)))
        if h: FS[h[0]] += data
        if arg(3): wr32(arg(3), arg(2))
        ret, pop = 1, 20
    elif name == "ReadFile":
        h = HANDLES[arg(0)]
        data = FS[h[0]][h[1]:h[1] + arg(2)]; h[1] += len(data)
        uc.mem_write(arg(1), bytes(data)); wr32(arg(3), len(data))
        ret, pop = 1, 20
    elif name == "CloseHandle": HANDLES.pop(arg(0), None); ret, pop = 1, 4
    elif name == "CopyFileA":
        src, dst = (fsstate["cwd"], read_cstr(arg(0))), (fsstate["cwd"], read_cstr(arg(1)))
        if src in FS: FS[dst] = bytearray(FS[src]); ret = 1
        else: ret = 0
        pop = 12
    elif name == "VirtualAlloc": ret, pop = 0x01000000, 16
    elif name == "SetDirDocs": fsstate["cwd"] = "docs"
    elif name == "SetDir": fsstate["cwd"] = "root" if read_cstr(arg(0)) == "" else read_cstr(arg(0))
    elif name == "OpenWrite":
        key = (fsstate["cwd"], read_cstr(arg(0)))
        FS[key] = bytearray(); fsstate["next"] += 1; ret = fsstate["next"]; HANDLES[ret] = [key, 0]
    elif name == "FileWrite":
        FS[HANDLES[arg(0)][0]] += bytes(uc.mem_read(arg(1), arg(2))); ret = arg(2)
    elif name == "FileClose": HANDLES.pop(arg(0), None)
    elif name == "FlushFileBuffers": ret, pop = 1, 4
    elif name == "timeGetTime": ret = state.setdefault("ms", 1000)
    elif name == "LookAround": state["look"] = state.get("look", 0) + 1
    elif name == "PlaybackThisFrame": playback()
    elif name == "PlayFromHD": play_from_hd()
    elif name == "Finish": wr8(MODE, 0)
    elif name == "GetPad": ret = pad_area
    elif name == "PrintString": state["text"].append(read_cstr(arg(2), True))
    u.reg_write(UC_X86_REG_EAX, ret)
    if pop:   # stdcall: emulate 'ret pop'
        r = rd32(esp)
        u.reg_write(UC_X86_REG_ESP, esp + 4 + pop)
        u.reg_write(UC_X86_REG_EIP, r)

uc.hook_add(UC_HOOK_CODE, on_code, begin=STUB_BASE, end=STUB_BASE + 0x1000)
uc.hook_add(UC_HOOK_CODE, on_code, begin=0x400000, end=0x700000)
STACK = 0x003F0000

def call(addr, until):
    uc.reg_write(UC_X86_REG_ESP, STACK)
    uc.emu_start(addr, until)

def ret_call(addr):
    uc.reg_write(UC_X86_REG_ESP, STACK)
    wr32(STACK, 0x00210000); uc.mem_write(0x00210000, b"\xF4")
    uc.emu_start(addr, 0x00210000)
    return uc.reg_read(UC_X86_REG_EAX)

def frame(press=()):
    state["ms"] = state.get("ms", 1000) + 33
    keys.clear(); keys.update(press)
    state["text"] = []
    call(0x4A45C3, 0x4A45C8)
    call(0x4A61D6, 0x4A61DB)

# ---- frame table (Python) for expectations --------------------------------
from repparse import frames as pframes  # noqa: E402
NFR = sum(1 for _ in pframes(rep_bufs))

def status_line():
    for t in state["text"]:
        if t.startswith("PAUSED") or t.startswith("PLAYING"):
            return t
    return None

def shown():
    s = status_line()
    return int(s.split("FRAME ")[1].split(" /")[0]) - 1 if s else None

fails = []
def check(cond, what):
    print(("  ok   " if cond else "  FAIL ") + what)
    if not cond:
        fails.append(what)

print("RE_Init ->", ret_call(RE_INIT), "| second call ->", ret_call(RE_INIT))
print("frames in file:", NFR)
frame(); frame()
check(rd8(MODE) == 0 and status_line() is None, "idle: recording, no editor HUD")
frame([0x73]); frame()
check(rd8(MODE) == 1, "F4 loads the replay")
check(shown() == 0 and "PAUSED" in status_line(), "starts paused on frame 0: %s" % status_line())
for _ in range(10): frame()
check(shown() == 0, "stays paused")
for _ in range(5): frame([0x27]); frame()
check(shown() == 5, "Right x5 -> frame 5 (%s)" % shown())
frame([0x10, 0x27]); frame([0x10])
check(shown() == 35, "Shift+Right -> frame 35 (%s)" % shown())
frame([0x25]); frame()
check(shown() == 34, "Left -> 34 (%s)" % shown())
frame([0x10, 0x25]); frame([0x10])
check(shown() == 4, "Shift+Left -> 4 (%s)" % shown())
frame([0x23]); frame()
check(shown() == NFR - 1, "End -> last frame (%s)" % shown())
for _ in range(30): frame()
check(rd8(MODE) == 1 and not state["finished"], "paused at end does not finish playback")
frame([0x20]); frame()
check(shown() <= 2 and "PLAYING" in status_line(), "Space at end restarts from 0 (%s after 2 frames)" % shown())
for _ in range(100): frame()
check(abs(shown() - 101) <= 1, "1x plays one frame per game frame (%s)" % shown())
frame([0x35]); frame()
s0 = shown()
for _ in range(50): frame()
check(abs(shown() - s0 - 200) <= 4, "4x speed (%d -> %d)" % (s0, shown()))
frame([0x31]); frame()
s0 = shown()
for _ in range(40): frame()
check(abs(shown() - s0 - 10) <= 1, "0.25x speed (%d -> %d)" % (s0, shown()))
frame([0x33])
for _ in range(NFR * 4): frame()
check(rd8(MODE) == 1 and not state["finished"] and "PAUSED" in status_line(),
      "1x to the end: auto-pause, never finishes (%s)" % shown())
frame([0x24]); frame()
check(shown() == 0, "Home -> 0 (%s)" % shown())
frame([0x31]); frame([0x20])
for _ in range(NFR * 5): frame()
check(rd8(MODE) == 1 and not state["finished"], "0.25x to the end never finishes (%s)" % shown())
# cross every buffer boundary backwards one frame at a time near boundaries
frame([0x33]); frame([0x23]); frame()
ok = True
for _ in range(NFR - 1):
    before = shown(); frame([0x25]); frame()
    if shown() != before - 1:
        ok = False; print("    left from", before, "->", shown()); break
check(ok, "Left from the last frame back to 0, one by one, across buffer boundaries")
frame([0x73]); frame()
check(rd8(MODE) == 0 and status_line() is None, "F4 exits: playback finished by the editor, HUD gone")
check(not state["finished"], "game never hit end-of-data on its own")
# ---------------- phase 3: free camera + keyframes ------------------------
import math
def fset(a, v): uc.mem_write(a, struct.pack("<f", v))
def fget(a): return struct.unpack("<f", bytes(uc.mem_read(a, 4)))[0]
def campos(): return [fget(0x7E46B8 + 4 * k) for k in range(3)]
def camfwd(): return [fget(0x7E4698 + 4 * k) for k in range(3)]
def rwpos(): return [fget(RWFRAME + 0x10 + 0x30 + 4 * k) for k in range(3)]
def hudline(prefix):
    for t in state["text"]:
        if t.startswith(prefix) or (prefix == "KEYFRAMES" and "KEYFRAMES " in t): return t
    return ""
def player(f):
    fr = list(pframes(rep_bufs))[f]
    g = [raw for t, _b, _o, raw in fr if t == 5][0]
    return struct.unpack_from("<3f", g, 0x4C)
# a plausible recorded camera so pose_from_camera has something to read
for k, v in enumerate((0, 1, 0)): fset(0x7E4688 + 4 * k, v)       # right
for k, v in enumerate((1, 0, 0)): fset(0x7E4698 + 4 * k, v)       # fwd
for k, v in enumerate((0, 0, 1)): fset(0x7E46A8 + 4 * k, v)       # up
for k, v in enumerate((100, 200, 30)): fset(0x7E46B8 + 4 * k, v)  # pos
fset(0x696658, 70.0)
frame([0x73]); frame()
check(rd8(MODE) == 1 and "CAM RECORDED" in (status_line() or ""), "re-enter, recorded camera: %s" % (status_line() or ""))
check(any(t.startswith("PLAYBACK") for t in state["text"]), "help box shown")
frame([ord('H')]); frame()
check(not any(t.startswith("PLAYBACK") for t in state["text"]) and "H SHOW HELP" in state["text"], "H hides help")
frame([0x09]); frame()
check("CAM FREE" in (status_line() or ""), "Tab -> free camera")
p0 = campos()
check(max(abs(a - b) for a, b in zip(p0, (100, 200, 30))) < 1e-3, "free cam starts at current camera %s" % p0)
for _ in range(30): frame([ord('W')])
p1 = campos()
check(abs(p1[0] - 100 - 12.0 * 30 * 0.033) < 0.6 and abs(p1[1] - 200) < 1e-2, "W moves forward ~12 m/s: %s" % p1)
check(max(abs(a - b) for a, b in zip(rwpos(), p1)) < 1e-4, "RW frame matrix follows TheCamera")
fset(0x94D790, 20.0)
frame(); fset(0x94D790, 0.0); frame()
fw = camfwd()
check(abs(math.atan2(fw[1], fw[0]) - (-0.1)) < 1e-3, "mouse X turns yaw like the look-around cam (yaw %.3f)" % math.atan2(fw[1], fw[0]))
frame([ord('K')]); frame()
check("KEYFRAMES 1" in hudline("KEYFRAMES"), "K adds keyframe at frame 1: %s" % hudline("KEYFRAMES"))
kp0 = campos()
for _ in range(2): frame([0x10, 0x27]); frame([0x10])
check(shown() == 60, "Shift+Right x2 -> 60 (%s)" % shown())
for _ in range(20): frame([ord('D')])
frame([ord('K')]); frame()
kp1 = campos()
check("KEYFRAMES 2" in hudline("KEYFRAMES"), "second keyframe at 60")
frame([0x09]); frame([0x24]); frame()
check("CAM KEYFRAMES" in (status_line() or "") and max(abs(a - b) for a, b in zip(campos(), kp0)) < 1e-3,
      "frame 0 shows keyframe 1 pose (%s)" % campos())
for _ in range(2): frame([0x10, 0x27]); frame([0x10])
check(max(abs(a - b) for a, b in zip(campos(), kp1)) < 1e-3, "frame 60 shows keyframe 2 pose")
frame([0x24]); frame()
for _ in range(30): frame([0x27]); frame()
mid = campos()
check(min(kp0[i], kp1[i]) - 0.01 <= mid[i] <= max(kp0[i], kp1[i]) + 0.01 for i in range(3)) if False else None
check(all(min(kp0[i], kp1[i]) - 0.01 <= mid[i] <= max(kp0[i], kp1[i]) + 0.01 for i in range(3))
      and mid != kp0 and mid != kp1, "frame 30 interpolates between keys %s" % mid)
frame([0x21]); frame()
check("SELECTED 1" in hudline("KEYFRAMES") and shown() == 0, "PgUp selects keyframe 1 and seeks (%s)" % shown())
# Tab must start the free camera from the camera on screen, not the last free pose
for _ in range(30): frame([0x27]); frame()
onscreen = campos()
frame([0x09]); frame()
check("CAM FREE" in (status_line() or "") and max(abs(a - b) for a, b in zip(campos(), onscreen)) < 1e-3,
      "Tab again starts from the on-screen (keyframe path) camera %s" % campos())
frame([0x09]); frame([0x21]); frame()

frame([ord('B')]); frame()
for _ in range(30): frame([0x27]); frame()
check(max(abs(a - b) for a, b in zip(campos(), kp0)) < 1e-3, "B (cut) holds keyframe 1 until keyframe 2")
frame([0x21]); frame([ord('T')]); frame()
check("LOOK AT PLAYER" in hudline("KEYFRAMES"), "T -> LOOK AT PLAYER: %s" % hudline("KEYFRAMES"))
for _ in range(10): frame([0x27]); frame()
fw, pc, pl = camfwd(), campos(), player(shown())
d = [pl[0] - pc[0], pl[1] - pc[1], pl[2] + 0.6 - pc[2]]
n = math.sqrt(sum(x * x for x in d)); d = [x / n for x in d]
check(sum(a * b for a, b in zip(fw, d)) > 0.999, "LOOK AT aims at the recorded player")
# K: new keyframe inherits the previous keyframe's type; toast feedback
frame([0x09]); frame()                       # free cam on
for _ in range(10): frame([0x27]); frame()   # frame 20: between key 1 (LOOK) and key 2
frame([ord('K')])
toast = [t for t in state["text"] if t.startswith("KEYFRAME ") and ("ADDED" in t or "UPDATED" in t)]
k1type = "LOOK AT PLAYER" if "LOOK" in hudline("KEYFRAMES") else ""
check(toast and "ADDED" in toast[0], "K shows an ADDED toast: %s" % toast)
check(toast and toast[0].endswith("LOOK AT PLAYER"), "new keyframe inherits previous type (LOOK AT PLAYER): %s" % toast)
frame(); frame([ord('K')])
toast = [t for t in state["text"] if t.startswith("KEYFRAME ")]
check(toast and "UPDATED" in toast[0], "K again on the same frame shows UPDATED: %s" % toast)
for _ in range(12): frame()
check(bool([t for t in state["text"] if t.startswith("KEYFRAME ")]), "toast still visible after 0.4 s")
for _ in range(5): frame()
check(not [t for t in state["text"] if t.startswith("KEYFRAME ")], "toast gone after 0.56 s")
frame([0x2E]); frame(); frame([0x09]); frame()
frame([0x21]); frame(); frame([ord('T')]); frame(); frame([ord('T')]); frame()
check("RECORDED CAMERA" in hudline("KEYFRAMES"), "T x2 more -> RECORDED")
look_before = state.get("look", 0)
for _ in range(5): frame([0x27]); frame()
check(state.get("look", 0) > look_before and "CAM RECORDED" in (status_line() or ""), "RECORDED segment uses the game camera")
frame([0x22]); frame([0x2E]); frame()
check("KEYFRAMES 1" in hudline("KEYFRAMES"), "PgDn + Del deletes keyframe 2")
frame([ord('P')]); frame()
check("PLAYING" in (status_line() or "") and shown() <= 2, "P previews from the start")
for _ in range(NFR + 50): frame()
check(rd8(MODE) == 1 and not state["finished"], "preview runs to the end without finishing")
frame([0x73]); frame()
check(rd8(MODE) == 0 and abs(fget(0x696658) - 70.0) < 1e-4, "exit restores FOV 70")
# ---------------- phase 4: trim, save, project -----------------------------
import tempfile
from reptrim import validate
def toast_with(prefix):
    return [t for t in state["text"] if t.startswith(prefix)]
frame([0x73]); frame()
check(rd8(MODE) == 1 and toast_with("PROJECT LOADED - 1 KEYFRAMES"), "project of the previous session reloaded (1 keyframe)")
frame([0x22]); frame(); frame([0x2E]); frame()
check("KEYFRAMES 0" in hudline("START"), "old keyframe deleted: %s" % hudline("START"))
frame([0x10, 0x27]); frame([0x10])
check(shown() == 30, "at frame 30 (%s)" % shown())
frame([ord('I')])
check(toast_with("START - FRAME 31"), "I sets the start mark: %s" % toast_with("START"))
frame()
for _ in range(5): frame([0x10, 0x27]); frame([0x10])
for _ in range(20): frame([0x27]); frame()
check(shown() == 200, "at frame 200 (%s)" % shown())
frame([ord('O')])
check(toast_with("END - FRAME 201"), "O sets the end mark: %s" % toast_with("END"))
frame([0x24]); frame()
check(shown() == 30, "Home -> start mark (%s)" % shown())
frame([0x23]); frame()
check(shown() == 200, "End -> end mark (%s)" % shown())
# keyframes at 50 and 150 with the free camera
frame([0x24]); frame()
for _ in range(20): frame([0x27]); frame()
frame([0x09]); frame()
for _ in range(10): frame([ord('W')])
frame([ord('K')]); frame()
keyA = campos()
for _ in range(100): frame([0x27]); frame()
for _ in range(15): frame([ord('D')])
frame([ord('K')]); frame()
keyB = campos()
frame([0x09]); frame()
check("KEYFRAMES 2" in hudline("START") and shown() == 150, "keyframes at 50 and 150")
frame([ord('P')]); frame()
for _ in range(400): frame()
check(shown() == 200 and "PAUSED" in status_line() and rd8(MODE) == 1, "preview plays start->end mark and stops (%s)" % shown())
frame([0x74])
check(toast_with("SAVED replay_edit.rep - 171 FRAMES"), "F5 saves: %s" % toast_with("SAVED"))
frame()
out = FS.get(("docs", "replay_edit.rep"))
check(out is not None and out[:8] == b"gtaVC7f\0" and (len(out) - 8) % 100000 == 0, "replay_edit.rep written in the user folder")
check(fsstate["cwd"] == "root", "directory restored after saving")
tmp = os.path.join(tempfile.gettempdir(), "emu_saved.rep")
open(tmp, "wb").write(bytes(out))
obufs = load(tmp)
ofr = list(pframes(obufs))
check(len(ofr) == 171, "saved file has 171 frames (%d)" % len(ofr))
try:
    validate(obufs, 171); ok = True
except AssertionError as ex:
    ok = False; print("    ", ex)
check(ok, "every PED_UPDATE has its PED_HEADER in the same buffer")
sfr = list(pframes(rep_bufs))
same, cam_ok = True, True
for j, fo in enumerate(ofr):
    fs = sfr[30 + j]
    po = [raw for t, _b, _o, raw in fo if t != 3]
    ps = [raw for t, _b, _o, raw in fs if t != 3]
    go = [raw for raw in po if raw[0] == 5][0]
    gs = [raw for raw in ps if raw[0] == 5][0]
    if [r for r in po if r[0] != 5] != [r for r in ps if r[0] != 5] or go[:4] != gs[:4] or go[0x44:] != gs[0x44:]:
        same = False
    f = 30 + j
    if f < 50 and go != gs:
        cam_ok = False; print("    recorded camera changed at", f)
check(same, "all other packets identical to source frames 30..200")
check(cam_ok, "frames before the first keyframe keep the recorded camera")
def gpos(fr): g = [raw for t, _b, _o, raw in fr if t == 5][0]; return struct.unpack_from("<3f", g, 4 + 0x30)
check(max(abs(a - b) for a, b in zip(gpos(ofr[50 - 30]), keyA)) < 1e-3, "frame 50 camera = keyframe A %s" % (gpos(ofr[20]),))
check(max(abs(a - b) for a, b in zip(gpos(ofr[150 - 30]), keyB)) < 1e-3, "frame 150 camera = keyframe B")
check(max(abs(a - b) for a, b in zip(gpos(ofr[200 - 30]), keyB)) < 1e-3, "after the last keyframe the camera holds keyframe B")
frame([0x74]); frame()
check(("docs", "replay_edit.rep.bak") in FS, "second save keeps replay_edit.rep.bak")
check(("root", "CLEO\\ReplayEditor\\replay.rep.prj") in FS, "project file written")
frame([0x73]); frame()
frame([0x73]); frame()
check(toast_with("PROJECT LOADED - 2 KEYFRAMES"), "re-enter restores 2 keyframes")
frame([0x24]); frame()
check(shown() == 30, "start mark restored (%s)" % shown())
frame([0x23]); frame()
check(shown() == 200, "end mark restored (%s)" % shown())
frame([0x73]); frame()
print("playback calls:", state["plays"])
print("RESULT:", "PASS" if not fails else "FAIL %d" % len(fails))
sys.exit(1 if fails else 0)
