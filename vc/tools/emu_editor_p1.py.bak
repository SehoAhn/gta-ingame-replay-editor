# ---------------- SUB 1 (second replay merged into the project) -----------------
from repparse import frames as _frames
def slot_frames():
    """frames in the game's slots, in play order (status 1 slots then the status 2 one)"""
    st = [rd8(BUFSTATUS + i) for i in range(8)]
    order = [i for i in range(8) if st[i] == 1] + [i for i in range(8) if st[i] == 2]
    out = []
    for i in order:
        b = bytes(uc.mem_read(BUFFERS + i * 100000, 100000))
        for fr in _frames([b]):
            out.append([(t, raw) for t, _b, _o, raw in fr])
    return out
def merged_ok(frs):
    """game rules: one GENERAL/CLOCK/WEATHER/TIMER per frame, vehicles / peds ascending, header before update"""
    errs = []
    for k, fr in enumerate(frs):
        ts = [t for t, _ in fr]
        for t in (5, 6, 7, 9):
            if ts.count(t) != 1: errs.append("frame %d: %d x type %d" % (k, ts.count(t), t))
        vs = [r[1] for t, r in fr if t in (1, 2)]
        pu = [r[1] for t, r in fr if t == 4]
        if vs != sorted(set(vs)): errs.append("frame %d: vehicles %s" % (k, vs))
        if pu != sorted(set(pu)): errs.append("frame %d: peds %s" % (k, pu))
    return errs[:3]
def frames_total():
    sl = status_line()
    return int(sl.split("FRAME ")[1].split(" / ")[1].split()[0]) if sl else None
